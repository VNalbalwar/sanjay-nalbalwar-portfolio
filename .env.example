# Public site URL (used for canonical links, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form: Resend (free tier: 100 emails/day). Sign up at resend.com, create an API key.
RESEND_API_KEY=
CONTACT_TO_EMAIL=slnalbalwar@gmail.com
# Until a domain is verified in Resend, keep the default sender below.
CONTACT_FROM_EMAIL="Website contact <onboarding@resend.dev>"

# Spam protection: Cloudflare Turnstile (free). Leave both empty to use honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
