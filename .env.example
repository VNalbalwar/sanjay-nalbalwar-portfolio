# Public site URL (used for canonical links, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form: Gmail SMTP via Nodemailer.
# 1) Turn on 2-Step Verification on the Google account.
# 2) Create an App Password at https://myaccount.google.com/apppasswords (16 characters).
# Never use the normal Google password; never commit these values.
SMTP_USER=slnalbalwar@gmail.com
SMTP_APP_PASSWORD=
# Where messages are delivered (defaults to SMTP_USER)
CONTACT_TO_EMAIL=slnalbalwar@gmail.com

# Spam protection: Cloudflare Turnstile (free). Leave both empty to use honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
